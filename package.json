{
  "name": "@maplibre/maplibre-gl-compare",
  "version": "0.6.0-dev",
  "description": "Swipe and sync between two MapLibre maps",
  "funding": "https://github.com/maplibre/maplibre-gl-js?sponsor=1",
  "main": "dist/maplibre-gl-compare.js",
  "directories": {
    "example": "example"
  },
  "scripts": {
    "start": "cp style.css example/style.css && esbuild example/index.js --bundle --format=esm --outfile=example/bundle.js --servedir=example --serve --watch",
    "build": "mkdir -p dist && cp style.css dist/maplibre-gl-compare.css && esbuild index.js --bundle --format=esm --minify --outfile=dist/maplibre-gl-compare.js",
    "test": "npm run lint && npm run test:esm && npm run test:types && npm run test:browser",
    "lint": "eslint --no-eslintrc -c .eslintrc index.js sync-move.js validate.js example/index.js test/*.js test/support/*.js",
    "docs": "documentation build index.js --format=md > API.md",
    "test:esm": "npm run build && node --test test/esm.js test/unit.js test/stress.js test/fuzz.js",
    "test:browser": "node --test test/browser.js test/browser-stress.js",
    "prepack": "npm run build",
    "test:types": "node --test test/types.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maplibre/maplibre-gl-compare.git"
  },
  "keywords": [
    "maplibre",
    "maplibregl",
    "maps",
    "gl",
    "ui"
  ],
  "license": "ISC",
  "devDependencies": {
    "documentation": "^13.2.5",
    "eslint": "^8.9.0",
    "maplibre-gl": "^6.16.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "events": "^3.3.0"
  },
  "peerDependencies": {
    "maplibre-gl": ">=2.1.6"
  },
  "type": "module",
  "module": "dist/maplibre-gl-compare.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/maplibre-gl-compare.js"
    },
    "./dist/maplibre-gl-compare.css": {
      "types": "./dist/maplibre-gl-compare.css.d.ts",
      "default": "./dist/maplibre-gl-compare.css"
    },
    "./style.css": {
      "types": "./style.css.d.ts",
      "default": "./style.css"
    },
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts"
}
