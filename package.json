{
  "name": "@maplibre/maplibre-gl-compare",
  "version": "0.6.0-dev",
  "description": "Swipe and sync between two MapLibre maps",
  "funding": "https://github.com/maplibre/maplibre-gl-js?sponsor=1",
  "main": "dist/maplibre-gl-compare.js",
  "directories": {
    "example": "example"
  },
  "scripts": {
    "start": "cp style.css example/style.css && esbuild example/index.js --bundle --format=esm --outfile=example/bundle.js --servedir=example --serve --watch",
    "build": "mkdir -p dist && cp style.css dist/maplibre-gl-compare.css && esbuild index.js --bundle --format=esm --minify --outfile=dist/maplibre-gl-compare.js",
    "test": "npm run lint && npm run test:esm && npm run test:browser",
    "lint": "eslint --no-eslintrc -c .eslintrc index.js example/index.js test/index.js test/esm.js",
    "docs": "documentation build index.js --format=md > API.md",
    "test:esm": "npm run build && node --test test/esm.js",
    "test:browser": "esbuild test/index.js --bundle --format=cjs --external:tape --external:maplibre-gl --outfile=test/bundle.cjs && browserify test/bundle.cjs -o test/bundle.js && smokestack -b firefox < test/bundle.js | tap-status",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maplibre/maplibre-gl-compare.git"
  },
  "keywords": [
    "maplibre",
    "maplibregl",
    "maps",
    "gl",
    "ui"
  ],
  "license": "ISC",
  "devDependencies": {
    "documentation": "^13.2.5",
    "eslint": "^8.9.0",
    "maplibre-gl": "^2.1.6",
    "smokestack": "^3.6.0",
    "tap-status": "^1.0.1",
    "tape": "^5.5.2",
    "esbuild": "^0.25.0",
    "browserify": "^17.0.0"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-sync-move": "^0.3.0",
    "events": "^3.3.0"
  },
  "peerDependencies": {
    "maplibre-gl": ">=2.1.6"
  },
  "type": "module",
  "module": "dist/maplibre-gl-compare.js",
  "exports": {
    ".": "./dist/maplibre-gl-compare.js",
    "./dist/maplibre-gl-compare.css": "./dist/maplibre-gl-compare.css",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  }
}
